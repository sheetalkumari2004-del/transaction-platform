# Postgres
DATABASE_URL=postgresql+asyncpg://txn_user:txn_pass@postgres:5432/txn_platform
# Sync URL used only by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg2://txn_user:txn_pass@postgres:5432/txn_platform

# Redis
REDIS_URL=redis://redis:6379/0

# App
APP_ENV=local
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=100
ACCOUNT_SUMMARY_CACHE_TTL_SECONDS=60
IMPORT_STREAM_NAME=import_jobs_stream
IMPORT_CONSUMER_GROUP=import_workers
UPLOAD_MAX_BYTES=524288000
